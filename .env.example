# ── Supabase (database + auth) ──────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── AI provider for the health coach ───────────────────────────────────
# AI provider for the health coach: "groq" (default) or "gemini"
# The coach tries Groq first, then Gemini, then offline replies — in that order
# unless AI_PROVIDER=gemini flips the preference.
AI_PROVIDER=groq

# Groq API key — free at https://console.groq.com
GROQ_API_KEY=<redacted>
# Optional: override the Groq model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API key — backup provider, free at https://aistudio.google.com/apikey
GEMINI_API_KEY=<redacted>
# Optional: override the Gemini model (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Resend API Key for Email Verification (https://resend.com)
# Only needed if email verification is re-enabled (see EMAIL_VERIFICATION_ENABLED in src/app/auth/page.tsx)
# RESEND_API_KEY=<redacted>
