# AI provider for the health coach: "gemini" (default) or "groq"
AI_PROVIDER=gemini

# Google Gemini API key — free at https://aistudio.google.com/apikey
GEMINI_API_KEY=<redacted>
# Optional: override the Gemini model (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Groq API key — fallback provider, https://console.groq.com
GROQ_API_KEY=<redacted>
# Optional: override the Groq model (default: qwen/qwen3-32b)
# GROQ_MODEL=qwen/qwen3-32b

# Resend API Key for Email Verification (https://resend.com)
# Only needed if email verification is re-enabled (see EMAIL_VERIFICATION_ENABLED in src/app/auth/page.tsx)
# RESEND_API_KEY=<redacted>
